<BiomeDefs>

  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <!-- Forest -->
  <BiomeDef name="forest" baseTile="forestGrass" goalTile="islandWater" pathTile="snow">

    <NoiseRangeSelector name="forest" range="0.5,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="1"></NoiseParams>
    </NoiseRangeSelector>
      
    <NoiseRangeSelector name="mountain" range="0.75,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="2"></NoiseParams>
    </NoiseRangeSelector>
      
    <NoiseRangeSelector name="smallTrees" range="0.75,1">
      <TagQuery doesNotHaveAny="path"></TagQuery>
      <NoiseParams outputRange="0,1" scale="10" numOctaves="3" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="4"></NoiseParams>
    </NoiseRangeSelector>
      
    <NoisePeakSelector name="bigTrees">
      <TagQuery doesNotHaveAny="path"></TagQuery>
      <NoiseParams outputRange="0,1" scale="10" numOctaves="1" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="5"></NoiseParams>
    </NoisePeakSelector>

    <TileGenerator runOrder="0" tile="deepForestGrass" selector="forest"></TileGenerator>
    <TileGenerator runOrder="1" tile="stone" selector="mountain"></TileGenerator>
    <EntityGenerator runOrder="98" entity="tree1x1" selector="smallTrees"></EntityGenerator>
    <EntityGenerator runOrder="99" entity="tree2x2" selector="bigTrees"></EntityGenerator>
    
  </BiomeDef>

  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <!-- Desert -->
  <BiomeDef name="desert" baseTile="sand" goalTile="islandWater" pathTile="snow">

    <NoiseRangeSelector name="sand" range="0.5,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="1"></NoiseParams>
    </NoiseRangeSelector>

    <NoiseRangeSelector name="sandstone" range="0.75,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="1"></NoiseParams>
    </NoiseRangeSelector>

    <NoiseRangeSelector name="mountain" range="0.75,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="2"></NoiseParams>
    </NoiseRangeSelector>

    <NoisePeakSelector name="cacti">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="1" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="5"></NoiseParams>
    </NoisePeakSelector>

    <TileGenerator runOrder="0" tile="sand" selector="sand"></TileGenerator>
    <TileGenerator runOrder="1" tile="sandstone" selector="sandstone"></TileGenerator>
    <TileGenerator runOrder="2" tile="stone" selector="mountain"></TileGenerator>
    <EntityGenerator runOrder="99" entity="cactus2x2" selector="cacti"></EntityGenerator>

  </BiomeDef>

  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <!-- River -->
  <BiomeDef name="river" baseTile="grass" goalTile="riverWater" pathTile="islandWater">

    <NoiseRangeSelector name="forest" range="0.5,1">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="2" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="1"></NoiseParams>
    </NoiseRangeSelector>

    <NoisePeakSelector name="bigTrees">
      <NoiseParams outputRange="0,1" scale="10" numOctaves="1" octavePersistence="0.5f" octaveScale="2.f" renormalize="true" seedOffset="5"></NoiseParams>
    </NoisePeakSelector>

    <DistanceFieldSelector name="shore" range="1,1">
      <TagQuery hasAny="path,goal"></TagQuery>
    </DistanceFieldSelector>

    <TileGenerator runOrder="0" tile="forestGrass" selector="forest"></TileGenerator>
    <TileGenerator runOrder="98" tile="sand" selector="shore"></TileGenerator>
    <EntityGenerator runOrder="99" entity="tree2x2" selector="bigTrees"></EntityGenerator>

  </BiomeDef>
  
</BiomeDefs>
