  <ProjectileHitAbilityDef name="Rainbow_ProjHitAbility" projectileDef="TowerProj" projSpeed="100">
    <Cooldown cooldown="2"></Cooldown>
    <Targeting maxRange="15"></Targeting>
    <Crit critChance="0.5"></Crit>
    <Chain maxChains="3"></Chain>
    <Multishot additionalTargets="3"></Multishot>
    <OnHit>
      <Scaling physical="1" burn="1" poison="1" slow="1" haste="1"/>
