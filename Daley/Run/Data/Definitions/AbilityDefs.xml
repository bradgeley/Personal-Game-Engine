      <Render tint="255,0,255,25"></Render>
    </AoEEffect> 
  </AoEHitAbilityDef>

  <PassiveAoEAbilityDef name="Rainbow_PassiveAoEAbility">
    <Targeting maxRange="3"></Targeting>
    <AoEEffect ratio="1" enabled="true">
      <Render tint="255,0,255,25"></Render>
    </AoEEffect>
  </PassiveAoEAbilityDef>

  <LaserAbilityDef name="Rainbow_LaserAbility">
    <Targeting maxRange="15"></Targeting>
    <Render tint="255,0,255, 100" depth="0.05"></Render>
    <Chain maxChains="3" chainDistance="2" chainPayloadMulti="0.5"></Chain>
    <Multishot additionalTargets="3"></Multishot>
    <OnHit ratio="1"> <!-- per second -->
      <AoEEffect radius="0.5" duration="0" ratio="1" enabled="true">
        <Render tint="255,0,255, 100" depth="0.95"></Render>
      </AoEEffect>
    </OnHit>
  </LaserAbilityDef>

